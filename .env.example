# Distribution Provider ("github" or "r2")
DISTRIBUTION_PROVIDER=github

# GitHub Releases Settings
GITHUB_USERNAME=your_github_username
GITHUB_REPO=your_releases_repo
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_RELEASE_TAG=latest
GITHUB_PUBLIC_DOWNLOAD_URL=https://github.com/your_username/your_releases_repo/releases/download/latest/app-release.apk

# Flutter APK Monitoring
APK_FILE_PATH=C:\Users\DELL\Desktop\school_app\build\app\outputs\flutter-apk\app-release.apk
APK_FILENAME=app-release.apk
PROJECT_NAME=School App
FLUTTER_PROJECT_ROOT=C:\Users\DELL\Desktop\school_app

# Local Server Settings
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8765
POLL_INTERVAL_SECONDS=2
STABILITY_CHECK_SECONDS=3
